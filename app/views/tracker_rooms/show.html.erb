<%= turbo_stream_from @tracker_room %>
<div class="tracker <%= "tracker--viewer" if @mode == :viewer %>">
    <div class="tracker-grid">
        <% @items.each do |item| %>
            <div class="tracker-item">
                <%= render item %>

                <% if @mode == :editor %>
                    <div class="tracker-item__controls">
                        <%= button_to "-", 
                            decrement_tracker_item_path(
                                item.tracker_room.slug, 
                                item
                            ), 
                            method: :patch, 
                            class: "tracker-button" %>

                        <%= button_to "+", 
                            increment_tracker_item_path(
                                item.tracker_room.slug, 
                                item
                            ), 
                            method: :patch, 
                            class: "tracker-button" %>
                    </div>
                <% end %>
            </div>
        <% end %>
    </div>

    <% if @mode == :editor %>
        <div class="tracker-actions">
            <%= button_to "Reset", reset_tracker_room_path(@tracker_room.slug), method: :patch, class: "reset-button" %>
        </div>
    <% end %>
</div>
