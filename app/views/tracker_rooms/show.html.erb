<%= turbo_stream_from @tracker_room %>
<div class="tracker <%= "tracker--editor" if @mode == :editor %> <%= "tracker--viewer" if @mode == :viewer %> <%= "tracker--progression" if @mode == :progression %>">
    <% if @mode == :editor || @mode == :viewer %>
        <div class="tracker-grid">
            <% @counter_items.each do |item| %>
                <div class="tracker-item">
                    <%= render partial: "tracker_items/tracker_item", locals: { tracker_item: item, mode: @mode } %>
                </div>
            <% end %>
        </div>
    <% end %>

    <% if @mode == :editor || @mode == :progression %>
        <div class="tracker-grid tracker-grid--progression">
            <% @progression_items.each do |item| %>
                <div class="tracker-item">
                    <%= render partial: "tracker_items/tracker_item", locals: { tracker_item: item, mode: @mode } %>
                </div>
            <% end %>
        </div>
    <% end %>

    <% if @mode == :editor %>
        <div class="tracker-actions">
            <%= button_to "Reset", reset_tracker_room_path(@tracker_room.slug), method: :patch, class: "reset-button" %>
        </div>
    <% end %>
</div>
